  "lines": [
    { "t": 904.0, "text": "श्रितकमलाकुचमण्डल धृतकुण्डल ए।" },
    { "t": 925.6, "text": "कलितललितवनमाल जय जय देव हरे॥" },

    { "t": 987.12, "text": "दिनमणिमण्डलमण्डन भवखण्डन ए।" },
    { "t": 1010.56, "text": "मुनिजनमानसहंस जय जय देव हरे ॥" },

    { "t": 1041.6, "text": "कालियविषधरगंजन जनरंजन ए।" },
    { "t": 1063.6, "text": "यदुकुलनलिनदिनेश जय जय देव हरे ॥" },

    { "t": 1093.44, "text": "राधे कृष्णा हरे गोविंद गोपाला नन्द जू को लाला ।" },
    { "t": 1109.36, "text": "यशोदा दुलाला जय जय देव हरे ॥" },

    { "t": 1179.01, "text": "मधुमुरनरकविनाशन गरुडासन ए।" },
    { "t": 1201.28, "text": "सुरकुलकेलिनिदान जय जय देव हरे ॥" },

    { "t": 1232.88, "text": "अमलकमलदललोचन भवमोचन ए।" },
    { "t": 1254.8, "text": "त्रिभुवनभवननिधान जय जय देव हरे ॥" },

    { "t": 1284.88, "text": "जनकसुताकृतभूषण जितदूषण ए।" },
    { "t": 1308.32, "text": "समरशमितदशकण्ठ जय जय देव हरे ॥" },

    { "t": 1338.4, "text": "राधे कृष्णा हरे गोविंद गोपाला नन्द जू को लाला ।" },
    { "t": 1354.32, "text": "यशोदा दुलाला जय जय देव हरे ॥" },

    { "t": 1423.6, "text": "अभिनवजलधरसुन्दर धृतमन्दर ए।" },
    { "t": 1445.76, "text": "श्रीमुखचन्द्रचकोर जय जय देव हरे ॥" },
    { "t": 1507.92, "text": "अभिनवजलधरसुन्दर धृतमन्दर ए।" },
    { "t": 1531.52, "text": "श्रीमुखचन्द्रचकोर जय जय देव हरे ॥" },

    { "t": 1561.84, "text": "तव चरणे प्रणता वयमिति भावय ए।" },
    { "t": 1584.8, "text": "कुरु कुशलंव प्रणतेषु जय जय देव हरे ॥" },

    { "t": 1613.12, "text": "श्रीजयदेवकवेरुदितमिदं कुरुते मृदम् ।" },
    { "t": 1637.68, "text": "मंगलमंजुलगीतं जय जय देव हरे ॥" }
  ]

{
  "slug": "shri-radha-kripa-kataksh-stotram",
  "videoId": "tjuOcC7B9jk",
  "start": 2778,
  "end": 3791,
  "lines": [
    { "t": 2802.24, "verse": 1, "text": "मुनीन्द्रवृन्दवन्दिते त्रिलोकशोकहारिणी," },
    { "t": 2814.64, "text": "प्रसन्नवक्त्रपंकजे निकुंजभूविलासिनी।" },
    { "t": 2826.72, "text": "व्रजेन्द्रभानुनन्दिनी व्रजेन्द्रसूनुसंगते," },
    { "t": 2839.44, "text": "कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥" },

    { "t": 2864.48, "verse": 2, "text": "अशोकवृक्षवल्लरी वितानमण्डपस्थिते," },
    { "t": 2877.44, "text": "प्रवालज्वालपल्लव प्रभारुणाङ्घ्रिकोमले।" },
    { "t": 2890.16, "text": "वराभयस्फुरत्करे प्रभूतसम्पदालये," },
    { "t": 2902.88, "text": "कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥" },

    { "t": 3016.32, "verse": 3, "text": "अनङ्गरङ्गमङ्गल प्रसङ्गभङ्गुरभ्रुवां," },
    { "t": 3032.4, "text": "सविभ्रमं ससम्भ्रमं दृगन्तबाणपातनैः।" },
    { "t": 3042.0, "text": "निरन्तरं वशीकृत प्रतीतनन्दनन्दने," },
    { "t": 3054.8, "text": "कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥" },

    { "t": 3079.68, "verse": 4, "text": "तडित्सुवर्णचम्पक प्रदीप्तगौरविग्रहे," },
    { "t": 3092.88, "text": "मुखप्रभापरास्त कोटिशारदेन्दुमण्डले।" },
    { "t": 3105.44, "text": "विचित्रचित्रसञ्चरच्चकोरशावलोचने," },
    { "t": 3118.48, "text": "कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥" },

    { "t": 3143.36, "verse": 5, "text": "मदोन्मदातियौवने प्रमोदमानमण्डिते," },
    { "t": 3156.48, "text": "प्रियानुरागरञ्जिते कलाविलासपण्डिते।" },
    { "t": 3169.52, "text": "अनन्यधन्यकुञ्जराज कामकेलिकोविदे," },
    { "t": 3182.24, "text": "कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥" },

    { "t": 3206.96, "verse": 6, "text": "अशेषहावभावधीर हीरहारभूषिते," },
    { "t": 3220.16, "text": "प्रभूतशातकुम्भकुम्भ कुम्भिकुम्भसुस्तनी।" },
    { "t": 3233.2, "text": "प्रशस्तमन्दहास्यचूर्ण पूर्णसौख्यसागरे," },
    { "t": 3250.8, "text": "कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥" },

    { "t": 3298.88, "verse": 7, "text": "मृणालबालवल्लरी तरङ्गरङ्गदोर्लते," },
    { "t": 3311.92, "text": "लताग्रलास्यलोलनील लोचनावलोकने।" },
    { "t": 3324.4, "text": "ललल्लुलन्मिलन्मनोज्ञ मुग्धमोहनाश्रये," },
    { "t": 3337.68, "text": "कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥" },

    { "t": 3362.56, "verse": 8, "text": "सुवर्णमालिकाञ्चिते त्रिरेखकम्बुकण्ठगे," },
    { "t": 3375.6, "text": "त्रिसूत्रमङ्गलीगुण त्रिरत्नदीप्तिदीधिते।" },
    { "t": 3388.56, "text": "सलोलनीलकुन्तले प्रसूनगुच्छगुम्फिते," },
    { "t": 3401.2, "text": "कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥" },

    { "t": 3426.48, "verse": 9, "text": "नितम्बबिम्बलम्बमान पुष्पमेखलागुणे," },
    { "t": 3439.92, "text": "प्रशस्तरत्नकिङ्किणी कलापमध्यमञ्जुले।" },
    { "t": 3452.88, "text": "करीन्द्रशुण्डदण्डिकावरोह सौभगोरुके," },
    { "t": 3463.92, "text": "कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥" },

    { "t": 3478.24, "verse": 10, "text": "अनेकमन्त्रनादमञ्जु नूपुरारवस्खलत्," },
    { "t": 3491.6, "text": "समाजराजहंसवंश निक्वणातिगौरवे।" },
    { "t": 3504.8, "text": "विलोलहेमवल्लरी विडम्बिचारुचङ्क्रमे," },
    { "t": 3515.12, "text": "कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥" },

    { "t": 3543.04, "verse": 11, "text": "अनन्तकोटिविष्णुलोक नम्रपद्मजार्चिते," },
    { "t": 3560.96, "text": "हिमाद्रिजापुलोमजा विरिञ्चिजावरप्रदे।" },
    { "t": 3569.36, "text": "अपारसिद्धिवृद्धिदिग्ध सत्पदाङ्गुलीनखे," },
    { "t": 3581.92, "text": "कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥" },

    { "t": 3594.96, "verse": 12, "text": "मखेश्वरि क्रियेश्वरि स्वधेश्वरि सुरेश्वरि," },
    { "t": 3608.32, "text": "त्रिवेदभारतीश्वरि प्रमाणशासनेश्वरि।" },
    { "t": 3621.52, "text": "रमेश्वरि क्षमेश्वरि प्रमोदकाननेश्वरि," },
    { "t": 3634.72, "text": "व्रजेश्वरि व्रजाधिपे श्रीराधिके नमोऽस्तु ते॥" },

    { "t": 3693.28, "verse": 13, "text": "इतीदमद्भुतं स्तवं निशम्य भानुनन्दिनी," },
    { "t": 3706.72, "text": "करोतु सन्ततं जनं कृपाकटाक्षभाजनम्।" },
    { "t": 3719.68, "text": "भवेत्तदैव सञ्चित त्रिरूपकर्मनाशनं," },
    { "t": 3732.32, "text": "भवेत्तदा व्रजेन्द्रसूनु मण्डलप्रवेशनम्॥" }
  ]
}

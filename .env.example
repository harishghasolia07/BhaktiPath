# Copy to .env.local for local work, and add the same keys in Vercel → Project → Settings → Environment Variables.

# MongoDB Atlas connection string (free cluster). Without it, local dev uses .data/clips.json.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shravanam

# The admin page password, and a random 32+ character secret that signs the admin cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Lets `npm run clip` refresh the live site after adding a clip (any long random string).
REVALIDATE_SECRET=
# Vercel sends this to the daily keep-alive job (any long random string).
CRON_SECRET=

# The site's public address (used for link previews). Locally: http://localhost:3100
NEXT_PUBLIC_SITE_URL=
# Where `npm run clip` sends the refresh (usually the same as NEXT_PUBLIC_SITE_URL).
SITE_URL=
